{
  "info": {
    "name": "Task System API",
    "description": "Hexaware API Coding Challenge - Task System. Spring Boot 3.5.16 + JWT. Run 'Login (Basic Auth)' first: it stores the JWT in the collection variable {{token}} used by every other request. Customer policy requests expect the sample customers and policies in task_db.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "taskId", "value": "" }
  ],
  "item": [
    {
      "name": "Login (Basic Auth)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.test('Token is returned', function () { pm.expect(body.token).to.be.a('string').and.not.empty; });",
              "pm.test('Expiry is returned', function () { pm.expect(body.expiryTime).to.exist; });",
              "pm.collectionVariables.set('token', body.token);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "employee1", "type": "string" },
            { "key": "password", "value": "employee1", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/login",
        "description": "Spring Security validates the Basic credentials, then AuthController issues the JWT."
      },
      "response": []
    },
    {
      "name": "Create Task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Demo Task from Postman\",\n    \"description\": \"Created during the Postman collection run\",\n    \"dueDate\": \"2026-10-30\",\n    \"priority\": \"HIGH\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/tasks",
        "description": "Task ID is generated by MySQL; status is forced to PENDING by the service."
      },
      "response": []
    },
    {
      "name": "Get All Tasks",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "var list = pm.response.json();",
              "pm.test('Response is an array', function () { pm.expect(list).to.be.an('array'); });",
              "var matches = list.filter(function (x) { return x.title === 'Demo Task from Postman'; });",
              "pm.test('Created task is present', function () { pm.expect(matches.length).to.be.greaterThan(0); });",
              "var created = matches.sort(function (a, b) { return b.taskId - a.taskId; })[0];",
              "if (created) { pm.collectionVariables.set('taskId', created.taskId); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks"
      },
      "response": []
    },
    {
      "name": "Get Task By Id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "var task = pm.response.json();",
              "pm.test('Returns the requested task', function () { pm.expect(String(task.taskId)).to.eql(String(pm.collectionVariables.get('taskId'))); });",
              "pm.test('Status is PENDING after create', function () { pm.expect(task.status).to.eql('PENDING'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "response": []
    },
    {
      "name": "Update Task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"status\": \"COMPLETED\",\n    \"priority\": \"MEDIUM\",\n    \"description\": \"Updated through PUT\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "response": []
    },
    {
      "name": "Verify Update",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "var task = pm.response.json();",
              "pm.test('Status changed to COMPLETED', function () { pm.expect(task.status).to.eql('COMPLETED'); });",
              "pm.test('Priority changed to MEDIUM', function () { pm.expect(task.priority).to.eql('MEDIUM'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "response": []
    },
    {
      "name": "Filter By Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "var list = pm.response.json();",
              "pm.test('All returned tasks are COMPLETED', function () {",
              "  pm.expect(list).to.be.an('array');",
              "  list.forEach(function (x) { pm.expect(x.status).to.eql('COMPLETED'); });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/filter?status=COMPLETED",
        "description": "Extra GET capability, ready for the on-the-spot extension task."
      },
      "response": []
    },
    {
      "name": "Invalid Create (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Field error is returned', function () { pm.expect(pm.response.json().title).to.eql('Title is required'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"\",\n    \"dueDate\": \"2026-10-30\",\n    \"priority\": \"HIGH\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/tasks"
      },
      "response": []
    },
    {
      "name": "No Token (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401 without a token', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks"
      },
      "response": []
    },
    {
      "name": "Delete Task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "response": []
    },
    {
      "name": "Get Deleted Task (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 404', function () { pm.response.to.have.status(404); });",
              "pm.test('Error body has message and comments', function () {",
              "  var body = pm.response.json();",
              "  pm.expect(body.message).to.eql('Task not found');",
              "  pm.expect(body.comments).to.eql('Id not found in DB');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "response": []
    },
    {
      "name": "Filter Customer Policies",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "var list = pm.response.json();",
              "pm.test('Response is an array', function () { pm.expect(list).to.be.an('array'); });",
              "pm.test('Returns both matching policies', function () {",
              "  pm.expect(list).to.have.lengthOf(2);",
              "  var names = list.map(function (x) { return x.customerName; });",
              "  pm.expect(names).to.include.members(['Alice', 'Bob']);",
              "});",
              "pm.test('Rows contain the required DTO fields', function () {",
              "  list.forEach(function (row) {",
              "    pm.expect(row.customerId).to.be.a('number');",
              "    pm.expect(row.customerName).to.be.a('string').and.not.empty;",
              "    pm.expect(row.policyTitle).to.eql('Health Shield');",
              "    pm.expect(row.tenure).to.eql('ONE_YEAR');",
              "    pm.expect(row.type).to.be.oneOf(['THIRD_PARTY', 'COMPREHENSIVE']);",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/customer-policies/filter?tenure=ONE_YEAR&title=Health%20Shield&page=0&size=10",
        "description": "Returns customers and policy details for a given tenure and exact policy title. Requires the sample customers/policies in task_db."
      },
      "response": []
    },
    {
      "name": "Filter Customer Policies (Page 2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "var list = pm.response.json();",
              "pm.test('Page 2 returns exactly one row', function () { pm.expect(list).to.have.lengthOf(99); });",
              "pm.test('Row contains the required DTO fields', function () {",
              "  var row = list[0];",
              "  pm.expect(row.customerId).to.be.a('number');",
              "  pm.expect(row.customerName).to.be.a('string').and.not.empty;",
              "  pm.expect(row.policyTitle).to.eql('Health Shield');",
              "  pm.expect(row.tenure).to.eql('ONE_YEAR');",
              "  pm.expect(row.type).to.be.oneOf(['THIRD_PARTY', 'COMPREHENSIVE']);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/customer-policies/filter?tenure=ONE_YEAR&title=Health%20Shield&page=1&size=1",
        "description": "Verifies pagination: page=1, size=1 returns the second matching row."
      },
      "response": []
    },
    {
      "name": "Filter Customer Policies - Missing Tenure (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Error message is returned', function () {",
              "  pm.expect(pm.response.json().message).to.eql('tenure is required');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/customer-policies/filter?title=Health%20Shield&page=0&size=10",
        "description": "tenure is required. The service must return 400, not an empty array."
      },
      "response": []
    },
    {
      "name": "Filter Customer Policies - Missing Title (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Error message is returned', function () {",
              "  pm.expect(pm.response.json().message).to.eql('title is required');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/customer-policies/filter?tenure=ONE_YEAR&page=0&size=10",
        "description": "title is required. A blank or absent title must return 400."
      },
      "response": []
    },
    {
      "name": "Filter Customer Policies - Invalid Page (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Error message is returned', function () {",
              "  pm.expect(pm.response.json().message).to.eql('page must be greater than or equal to 0');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/customer-policies/filter?tenure=ONE_YEAR&title=Health%20Shield&page=-1&size=10",
        "description": "page must be greater than or equal to 0."
      },
      "response": []
    },
    {
      "name": "Filter Customer Policies - Invalid Size (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Error message is returned', function () {",
              "  pm.expect(pm.response.json().message).to.eql('size must be between 1 and 100');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/customer-policies/filter?tenure=ONE_YEAR&title=Health%20Shield&page=0&size=0",
        "description": "size must be between 1 and 100."
      },
      "response": []
    },
    {
      "name": "Filter Customer Policies - No Token (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401 without a token', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/customer-policies/filter?tenure=ONE_YEAR&title=Health%20Shield&page=0&size=10",
        "description": "The endpoint requires a valid JWT."
      },
      "response": []
    }
  ]
}
